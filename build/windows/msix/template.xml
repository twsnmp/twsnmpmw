<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="twsnmpmw"
        Arguments=""
        InstallLocation="C:\Program Files\TWSNMP\twsnmpmw">
    </Installer>
    <PackageInformation
        PackageName="twsnmpmw"
        PackageDisplayName="twsnmpmw"
        PublisherName="CN=TWSNMP"
        PublisherDisplayName="TWSNMP"
        Version="1.0.0.0"
        PackageDescription="Multi Windows Viewer for TWSNMP FC">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="jp.co.twise.twsnmpmw"
                Description="Multi Windows Viewer for TWSNMP FC"
                DisplayName="twsnmpmw"
                ExecutableName="twsnmpmw"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>twsnmpmw</DisplayName>
            <PublisherDisplayName>TWSNMP</PublisherDisplayName>
            <Description>Multi Windows Viewer for TWSNMP FC</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="twsnmpmw.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
